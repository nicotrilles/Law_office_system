# Copy this file to ".env" and fill in real values. ".env" is git-ignored.
# Real environment variables always override values in this file.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# Required. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://jumamil_app:CHANGE_ME@localhost:5432/jumamil_law

# Comma-separated host names (required for production settings).
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to the office's local time zone. Times are stored in UTC and shown in this zone.
TIME_ZONE=Asia/Manila

# Where uploaded documents will be stored. Must NOT be a publicly served folder.
# DOCUMENT_STORAGE_ROOT=/absolute/path/outside/the/web/root
# LOG_DIR=/absolute/path/to/logs
# LOG_LEVEL=INFO

# ---- Provisional development defaults (NOT confirmed office policy, see docs/DEVELOPMENT_NOTES.md) ----
# PASSWORD_MIN_LENGTH=12
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# ---- Production only ----
# HTTPS is not yet decided (hosting is open, X-UQ-008). These default to secure values in production.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=0
